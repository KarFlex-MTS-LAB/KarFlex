<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".OtpActivity">

    <ImageButton
        android:id="@+id/btnReturn"
        android:layout_width="24dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back Button"
        android:src="@drawable/ic_arrow_back"
        app:tint="@android:color/black" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Verify with OTP Code"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Subjudul / Deskripsi -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingRight="28dp"
        android:text="Please enter the 4 digits code that has been sent to your SMS."
        android:textColor="@color/dark_gray"
        android:textSize="14sp" />

    <!-- Layout Kotak OTP (Dibuat center secara horizontal) -->
    <LinearLayout
        android:id="@+id/layoutOtpBoxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:orientation="horizontal">

        <!-- Digit 1 -->
        <EditText
            android:id="@+id/etDigit1"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Digit 2 -->
        <EditText
            android:id="@+id/etDigit2"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Digit 3 -->
        <EditText
            android:id="@+id/etDigit3"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Digit 4 -->
        <EditText
            android:id="@+id/etDigit4"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't receive the code? "
            android:textColor="@android:color/black"
            android:textFontWeight="600"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend code"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Spacer untuk mendorong tombol verify ke bagian bawah (Opsional, menghapus berat constraint bottom) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:text="Verify"
        android:textColor="@android:color/white"
        android:textFontWeight="600"
        android:textSize="16sp"
        app:cornerRadius="8dp" />

</LinearLayout>