<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp"
    tools:context=".OtpActivity">

    <!-- Judul Halaman -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Verify with OTP Code"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subjudul / Deskripsi -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Please enter the 4 digits code that has been sent to your SMS."
        android:textColor="@color/dark_gray"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:paddingRight="28dp"/>

    <LinearLayout
        android:id="@+id/layoutOtpBoxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

        <!-- Digit 1 -->
        <EditText
            android:id="@+id/etDigit1"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Digit 2 -->
        <EditText
            android:id="@+id/etDigit2"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Digit 3 -->
        <EditText
            android:id="@+id/etDigit3"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Digit 4 -->
        <EditText
            android:id="@+id/etDigit4"
            android:layout_width="54dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="@drawable/shape_edittext_outline"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutResend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutOtpBoxes">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Haven't received the code? "
            android:textColor="@android:color/black"
            android:textFontWeight="600"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend code"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tombol Konfirmasi -->
    <Button
        android:id="@+id/btnVerify"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Verify"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textFontWeight="600"
        android:backgroundTint="@color/primary"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:cornerRadius="8dp" />



</androidx.constraintlayout.widget.ConstraintLayout>